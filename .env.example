# Public project coordinates. Copy to .env.local and fill from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional marketing generation; never prefix private keys with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Generate a strong random value before storing integration credentials.
INTEGRATIONS_ENCRYPTION_KEY=

# Local UI preview only; ignored in production. Writes are not persisted.
NEXT_PUBLIC_DEMO_MODE=false
